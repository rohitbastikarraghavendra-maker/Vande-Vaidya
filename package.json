{
  "name": "rural-health-triage",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx --env-file-if-exists=.env --env-file-if-exists=server/.env server/src/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "validate:fixtures": "tsx tests/fixtures.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "node tests/intake-browser.mjs",
    "test:llm": "tsx tests/live-extract.ts"
  },
  "dependencies": {
    "express": "^5",
    "express-rate-limit": "^8",
    "multer": "^2",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5",
    "@types/multer": "^2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9",
    "prettier": "^3.10.1",
    "tsx": "^4",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ]
}
